{
  "name": "hds-style-showcase",
  "version": "0.3.0",
  "description": "HDS style showcase, icons, and logos. Published at style.datasafe.dev.",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/healthdatasafe/style.git"
  },
  "keywords": [
    "HealthDataSafe",
    "CSS",
    "Icons"
  ],
  "author": "Health Data Safe (https://www.healthdatasafe.org)",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/healthdatasafe/style/issues"
  },
  "homepage": "https://github.com/healthdatasafe/style#readme",
  "scripts": {
    "build": "npm run copy && npm run minify && cp dist/hds.min.css dist/hds.css",
    "setup": "sh scripts/setup.sh",
    "deploy": "bash scripts/deploy.sh",
    "copy": "mkdir -p dist && rm -rf dist/* && cp -R src/* dist/ && rm dist/input.css",
    "css": "npx @tailwindcss/cli -i ./src/input.css -o ./src/hds.css --watch",
    "dev": "npx concurrently --kill-others \"npm run css\" \"npm run serve\"",
    "format": "npx prettier . --check",
    "format:fix": "npx prettier . --write",
    "minify": "npx @tailwindcss/cli -i ./src/input.css -o ./dist/hds.min.css --minify",
    "serve": "npx livereload ./src",
    "license": "source-licenser -c .licenser.yml ."
  },
  "dependencies": {
    "hds-style": "github:healthdatasafe/style-package#0.6.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.11",
    "@tailwindcss/typography": "^0.5.16",
    "concurrently": "^9.2.0",
    "livereload": "^0.9.3",
    "prettier": "3.6.2",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "source-licenser": "^2.0.6",
    "tailwindcss": "^4.1.11"
  }
}
